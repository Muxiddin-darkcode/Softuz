# Telegram Bot konfiguratsiyasi
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345678

# Adminlarning Telegram ID raqamlari (vergul bilan ajratilgan)
ADMINS=123456789,987654321

# Dasturlar saqlanadigan Yopiq Arxiv Kanalining ID si (masalan: -1001234567890)
STORAGE_CHANNEL_ID=-1001234567890

# Ma'lumotlar bazasi URL manzili:
# 1) Mahalliy SQLite (Kompyuterda test qilish uchun):
DATABASE_URL=sqlite+aiosqlite:///data/bot_database.sqlite3

# 2) Render / Neon.tech / Supabase (Bepul onlayn PostgreSQL - Renderda o'chib ketmaydi):
# DATABASE_URL=postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require
# yoki Supabase:
# DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
